# ==============================================================================
# 1. SERVIDOR & KEEP-ALIVE (RENDER FREE TIER)
# ==============================================================================
PORT=8085
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_MS=600000
RENDER_EXTERNAL_URL=

# ==============================================================================
# 2. SUPABASE API & AUTH
# ==============================================================================
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://SEU_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ==============================================================================
# 3. BANCO DE DADOS POSTGRESQL SUPABASE (JDBC / HIBERNATE)
# ==============================================================================
# Use o Session Pooler IPv4 (porta 5432) no Render Free Tier:
SUPABASE_DB_DRIVER=org.postgresql.Driver
SUPABASE_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=
DB_POOL_SIZE=5

# ==============================================================================
# 4. INTELIGÊNCIA FORMA (GOOGLE GEMINI API)
# ==============================================================================
GEMINI_API_KEY=

# ==============================================================================
# 5. AUTENTICAÇÃO SOCIAL (GOOGLE & APPLE) E JWT
# ==============================================================================
GOOGLE_CLIENT_ID=
JWT_SECRET=TroquePorUmaChaveAleatoriaSeguraComMaisDe32Caracteres!

# ==============================================================================
# 6. PAINEL ADMINISTRATIVO (/admin)
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha
ADMIN_KEY=troque_esta_chave

# ==============================================================================
# 7. E-MAIL TRANSACIONAL (RECUPERAÇÃO DE SENHA - OPCIONAL)
# ==============================================================================
RESEND_API_KEY=
MAIL_FROM=Forma <onboarding@resend.dev>
