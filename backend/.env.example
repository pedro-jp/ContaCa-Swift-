# Porta do Servidor Spring Boot (no Render o valor é injetado automaticamente)
PORT=8085

# Banco PostgreSQL Supabase (Use o Session Pooler IPv4 porta 5432 no Render Free Tier!)
# Exemplo: jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_DRIVER=org.postgresql.Driver
SUPABASE_DB_URL=
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=

# Inteligência Forma (Google Gemini API)
GEMINI_API_KEY=

# Google OAuth Client ID para autenticação social iOS
GOOGLE_CLIENT_ID=

# Segredo de Autenticação JWT (mínimo 32 caracteres)
JWT_SECRET=TroquePorUmaChaveAleatoriaSeguraComMaisDe32Caracteres!

# Credenciais do Painel Administrativo (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha
ADMIN_KEY=troque_esta_chave

# Opcional: envio de e-mail transacional na recuperação de senha (Resend)
RESEND_API_KEY=
MAIL_FROM=Forma <onboarding@resend.dev>
